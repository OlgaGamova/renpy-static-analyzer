# Объявление персонажей с указанием цвета их имени
define e = Character("Эйлин", color="#c8ffc8")
define mc = Character("Вы", color="#c8c8ff")

# Начало игры
label start:

    # Смена фона
    scene bg room
    with dissolve

    # Воспроизведение фоновой музыки
    play music "bgm_loop.ogg" fadein 1.0

    # Появление спрайта персонажа
    show eileen happy
    with dissolve

    "Солнечные лучи пробиваются сквозь жалюзи, освещая комнату."
    e "Привет! Готова начать наш первый сценарий на Ren'Py?"

    # Разветвление сюжета (Выбор игрока)
    menu:
        "Да, конечно!":
            jump route_positive

        "А это сложно?":
            jump route_question

# Ветка 1: Позитивный ответ
label route_positive:
    e "Отличный настрой! Писать код здесь так же просто, как обычный рассказ."
    mc "Звучит здорово, давай продолжим."
    jump end_scene

# Ветка 2: Сомнение
label route_question:
    e "Вовсе нет! Движок использует простой синтаксис, с которым разберется каждый."
    e "Попробуй сама написать пару строк, и ты всё поймешь."
    mc "Убедила, я готова учиться!"
    jump end_scene

# Завершение сцены
label end_scene:
    stop music fadeout 2.0
    show eileen normal

    "Эйлин дружелюбно машет вам рукой."
    e "Удачи в создании собственной визуальной новеллы!"

    # Возврат в главное меню
    return
